{
  "entities": {
    "software": {
      "title": "Software",
      "description": "Tanıtılan yazılım programları.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Yazılım başlığı" },
        "description": { "type": "string", "description": "Yazılım açıklaması (Markdown)" },
        "mediaUrl": { "type": "string", "description": "Resim veya YouTube video URL'si" },
        "mediaType": { "type": "string", "enum": ["image", "youtube"], "description": "Medya türü" },
        "isFeatured": { "type": "boolean", "description": "Öne çıkarılan içerik mi?" },
        "version": { "type": "string", "description": "Yazılım versiyonu" },
        "category": { "type": "string", "description": "Ana Kategori" },
        "subcategory": { "type": "string", "description": "Alt Kategori" },
        "downloadUrl": { "type": "string", "description": "İndirme bağlantısı" },
        "downloadUrl2": { "type": "string", "description": "Alternatif indirme bağlantısı" },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Etiketler" },
        "isPremium": { "type": "boolean", "description": "Ücretli/Premium mu?" },
        "specialNote": { "type": "string", "description": "Admin özel notu" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Oluşturulma tarihi" },
        "authorUid": { "type": "string", "description": "Paylaşan adminin UID'si" }
      },
      "required": ["title", "description", "mediaUrl", "mediaType", "createdAt", "authorUid"]
    },
    "users": {
      "title": "User",
      "description": "Kullanıcı profilleri.",
      "type": "object",
      "properties": {
        "nickname": { "type": "string", "description": "Kullanıcı adı" },
        "email": { "type": "string", "description": "E-posta (opsiyonel)" },
        "role": { "type": "string", "enum": ["admin", "moderator", "user"], "description": "Kullanıcı rolü" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Kayıt tarihi" }
      },
      "required": ["nickname", "role"]
    },
    "categories": {
      "title": "Category",
      "description": "Navigasyon kategorileri.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Kategori adı" },
        "subcategories": { "type": "array", "items": { "type": "string" }, "description": "Alt kategoriler" },
        "order": { "type": "number", "description": "Sıralama düzeni" }
      },
      "required": ["name", "subcategories", "order"]
    },
    "comments": {
      "title": "Comment",
      "description": "İçeriklere yapılan anonim yorumlar ve yanıtlar.",
      "type": "object",
      "properties": {
        "nickname": { "type": "string", "description": "Yorum yapanın takma adı" },
        "content": { "type": "string", "description": "Yorum içeriği" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Yorum tarihi" },
        "parentId": { "type": "string", "description": "Yanıtlanan yorumun ID'si (opsiyonel)" }
      },
      "required": ["nickname", "content", "createdAt"]
    },
    "settings": {
      "title": "Settings",
      "description": "Genel uygulama ve destek bağlantıları ayarları.",
      "type": "object",
      "properties": {
        "patreonUrl": { "type": "string", "description": "Patreon profili URL'si" },
        "patreonEnabled": { "type": "boolean", "description": "Patreon butonu aktif mi?" },
        "patreonLabel": { "type": "string", "description": "Patreon buton metni" },
        "kofiUrl": { "type": "string", "description": "Ko-fi profili URL'si" },
        "kofiEnabled": { "type": "boolean", "description": "Ko-fi butonu aktif mi?" },
        "kofiLabel": { "type": "string", "description": "Ko-fi buton metni" },
        "customLinks": { "type": "array", "description": "Özel destek bağlantıları listesi" },
        "heading": { "type": "string", "description": "Destek başlığı" }
      }
    },
    "visitor_sessions": {
      "title": "Visitor Sessions",
      "description": "Canlı ve aktif ziyaretçi oturumları.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "visitorId": { "type": "string" },
        "isBot": { "type": "boolean" },
        "botName": { "type": "string" },
        "isMember": { "type": "boolean" },
        "userId": { "type": "string" },
        "userNickname": { "type": "string" },
        "userRole": { "type": "string" },
        "path": { "type": "string" },
        "referrer": { "type": "string" },
        "device": { "type": "string" },
        "browser": { "type": "string" },
        "os": { "type": "string" },
        "lastActive": { "type": "string", "format": "date-time" },
        "startedAt": { "type": "string", "format": "date-time" }
      }
    },
    "visitor_logs": {
      "title": "Visitor Logs",
      "description": "Ziyaretçi ve arama motoru botu trafik logları.",
      "type": "object",
      "properties": {
        "visitorId": { "type": "string" },
        "sessionId": { "type": "string" },
        "isBot": { "type": "boolean" },
        "botName": { "type": "string" },
        "isMember": { "type": "boolean" },
        "userId": { "type": "string" },
        "userNickname": { "type": "string" },
        "path": { "type": "string" },
        "referrer": { "type": "string" },
        "device": { "type": "string" },
        "browser": { "type": "string" },
        "os": { "type": "string" },
        "userAgent": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/software/{softwareId}": {
      "schema": "software",
      "description": "Yazılım tanıtımları koleksiyonu."
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "Kullanıcı bilgileri koleksiyonu."
    },
    "/categories/{categoryId}": {
      "schema": "categories",
      "description": "Navigasyon kategorileri koleksiyonu."
    },
    "/software/{softwareId}/comments/{commentId}": {
      "schema": "comments",
      "description": "İçeriklere yapılan yorumlar."
    },
    "/settings/{settingId}": {
      "schema": "settings",
      "description": "Genel ayarlar ve destek bağlantıları."
    },
    "/visitor_sessions/{sessionId}": {
      "schema": "visitor_sessions",
      "description": "Canlı aktif ziyaretçiler oturum verileri."
    },
    "/visitor_logs/{logId}": {
      "schema": "visitor_logs",
      "description": "Ziyaretçi ve robot aktivite logları."
    }
  }
}
